{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TBT Paper Terminal",
  "version": "0.1.0",
  "identifier": "com.tbt.paperterminal",
  "build": {
    "beforeDevCommand": "npm run dev -- --host --port 5173",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "TBT Paper Terminal",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ]
  }
}
